# ──────────────────────────────────────────────────────────────
# n9e 单机部署 — 环境变量
# 复制为 .env 后修改密码和域名;.env 已被仓库 .gitignore 排除。
# ──────────────────────────────────────────────────────────────

# ─── 镜像 tag ─────────────────────────────────────────────
# 镜像完整名:fuqiangleon/o9e:${O9E_TAG}
#   默认 latest(滚动,部署侧 docker compose pull 拿最新)
#   生产想锁版本就改成 ci-42 / 1.0.5 等具体 tag,避免 latest 漂移
O9E_TAG=latest
# scanopy(server + daemon)镜像 tag:fuqiangleon/scanopy-{server,daemon}:${SCANOPY_TAG}
#   由 fork 的 build-images.sh 构建推送;默认 latest,锁版同理
SCANOPY_TAG=latest

# ─── 对外端口 ─────────────────────────────────────────────────
# 最小暴露:对外只有 443(Web/API)和 17000(agent 上报)。其余 *_BIND 默认 127.0.0.1,
# 确有需要才改 0.0.0.0。
HTTP_PORT=80
# 80 只做跳转 https,默认不对外
HTTP_BIND=127.0.0.1
HTTPS_PORT=443
# ibex RPC(远程执行),categraf 反向连接;agent 未启用 ibex 时保持本机
IBEX_RPC_PORT=20090
IBEX_RPC_BIND=127.0.0.1
# scanopy server 直连口(nginx 不反代它)。本机 daemon 走 127.0.0.1;有远端 daemon 才改 0.0.0.0
SCANOPY_PORT=60072
SCANOPY_BIND=127.0.0.1
# agent 上报入口(明文 HTTP,由 nginx 接管,只放行 agent 接口;登录与管理 API 只走 443)
AGENT_API_PORT=17000
# 1=非 agent 接口返回 403(默认);0=只记录不拦截(排障时用,看 logs/nginx/agent-api.log 的 path_ok)
AGENT_API_ENFORCE=1

# ─── 域名(用于 README 提示;nginx 模板用 server_name _ 通配)──
N9E_DOMAIN=o9e.example.com

# ─── 数据库 ───────────────────────────────────────────────────
# 默认用内置 MySQL(compose 的 mysql 服务,属于 builtin-db profile)。
# 改用外部数据库(客户提供的 MySQL / PostgreSQL / 金仓 PG 兼容模式)时:
#   1. COMPOSE_PROFILES 去掉 builtin-db(留空即可),内置 mysql 不再启动;
#   2. 填 DB_TYPE / DB_HOST / DB_PORT 及下面的业务账号口令(由 DBA 建库建账号,见 docs/external-db.md);
#   3. PostgreSQL / 金仓:首次部署前执行 ./external-db-init.sh(导入表结构、设 admin 初始密码、生成 N9E_DB_DSN)。
COMPOSE_PROFILES=builtin-db
# mysql | postgres(金仓须为 PG 兼容模式)
DB_TYPE=mysql
# 外部数据库地址;内置 MySQL 时保持 mysql / 3306
DB_HOST=mysql
DB_PORT=3306
N9E_DB_NAME=n9e_v6
TOPO_DB_NAME=topo_studio
# PostgreSQL / 金仓的传输加密:prefer=服务端开了 SSL 就加密(默认);require=强制加密(DBA 开启 SSL 后建议改);
# disable=明文。改后需重跑 external-db-init.sh 刷新 N9E_DB_DSN
DB_SSLMODE=prefer
# n9e 连接串:留空=按上面各项自动拼 MySQL 连接串;PostgreSQL / 金仓由 external-db-init.sh 生成写入
N9E_DB_DSN=

# 内置 MySQL 的 root 口令(仅 builtin-db 使用;initsql 建库时即生效)
MYSQL_ROOT_PASSWORD=please-change-me
# n9e / topo-studio 各用业务专用账号,只授权各自的库(initsql-extra/f-app-users.sh 创建);勿改回 root
N9E_DB_USER=n9e_app
N9E_DB_PASSWORD=please-change-me
TOPO_DB_USER=topo_app
TOPO_DB_PASSWORD=please-change-me
# 平台管理员 admin 的初始密码(仅新部署生效;init-env.sh 生成 20 位含符号的复杂密码,首次登录后可在页面修改)
N9E_ADMIN_PASSWORD=please-change-me

# ─── Redis 密码 ───────────────────────────────────────────────
REDIS_PASSWORD=please-change-me

# ─── VM 保留周期(单位:月)──────────────────────────────────
VM_RETENTION=3

# ─── Scanopy(网络拓扑发现服务)────────────────────────────────
# 镜像走 fork 版 fuqiangleon/scanopy-{server,daemon}:${SCANOPY_TAG}(tag 见上「镜像 tag」段)。
# fork 相对官方的改动:嵌入 n9e 的 UI(隐藏侧栏/主题对齐)、设备互联图、SNMP 存活兜底 —— 官方镜像缺这些,勿换。

# scanopy 后端 PostgreSQL 密码(独立于 n9e 的 mysql)
SCANOPY_POSTGRES_PASSWORD=please-change-me

# 部署后跑 ./scanopy-bootstrap.sh 自动完成:
#   1. POST /api/auth/setup     (用 ORG_NAME + NETWORK_NAME)
#   2. POST /api/auth/register  (用 ADMIN_EMAIL + ADMIN_PASSWORD)
#   3. login → 创建并启用 User API Key (用 KEY_NAME)
#   4. 写回下面 SCANOPY_TOKEN + 重启 n9e

# scanopy 管理员账号(scanopy UI 登录也用这个)
SCANOPY_ADMIN_EMAIL=admin@o9e.local
SCANOPY_ADMIN_PASSWORD=please-change-me

# scanopy 多租户的组织名(显示在 scanopy UI 上)
SCANOPY_ORG_NAME=o9e

# scanopy 第一次 setup 时创建的默认网络名(出现在网络列表)
SCANOPY_NETWORK_NAME=default

# n9e 调 scanopy 用的 API Key 名(可定位/审计用,不影响功能)
SCANOPY_KEY_NAME=n9e-integration

# n9e 调 scanopy 时带的 Bearer token(scp_u_ 开头)。
# 留空交给 scanopy-bootstrap.sh 写;手工填的话也可以,但要确保 key is_enabled=true。
SCANOPY_TOKEN=

# scanopy 注册控制(生产强烈建议锁掉,防止任何人自助注册新组织/账号):
#   false  → 默认,允许 POST /api/auth/register;首次部署 bootstrap 需要此项 false
#   true   → 禁用自助注册,新用户必须由 admin 通过 POST /api/v1/invites 邀请加入现 org
#
# 建议流程:首次部署保持 false → 跑 ./scanopy-bootstrap.sh 创 admin 和 key → 然后:
#   sed -i 's/^SCANOPY_DISABLE_REGISTRATION=.*/SCANOPY_DISABLE_REGISTRATION=true/' .env
#   docker compose up -d scanopy   # 重建容器吃新 env
SCANOPY_DISABLE_REGISTRATION=false

# ─── topo-studio(网络拓扑独立服务)──────────────────────────────
# n9e 反代 /api/topo-studio/* 与 /topo-studio/* 到 topo-studio 容器,带此 Bearer。
# init-env.sh 自动生成;留空则 topo-studio 不校验 token。
TOPO_API_TOKEN=

# ─── cfgsync 秘钥库 master key ─────────────────────────────────
# AES-256 master key(64 hex),加密存 cfgsync secret(如 SNMP 团体名等)。
# n9e 进程从此 env 读;留空则「新建秘钥」报 "秘钥库未初始化"。init-env.sh 自动生成。
# ⚠ 务必备份:一旦建过秘钥,丢失/变更此 key → DB 里所有 cfgsync 密文永久解不开。
N9E_SECRET_MASTER_KEY=

# ─── 日志监控(Elasticsearch + Logstash)──────────────────────────
# Logstash 收 agent nprobe 的 NetFlow(UDP)→ 写入 ES;n9e「日志探索」查 netflow-* 索引。
# ⚠ 镜像走 docker.elastic.co(1ms 不代理),本机需经代理能拉;宿主需 vm.max_map_count=262144
#    (init-env.sh 尝试自动设);ES+Logstash 都是 JVM 重负载,宿主内存建议 ≥8G。
ES_VERSION=8.15.3
# ES / Logstash 的 JVM heap,按宿主内存调(ES heap 建议 ≤ 物理内存一半)
ES_HEAP_SIZE=2g
LS_HEAP_SIZE=1g
# elastic 超级用户密码,init-env.sh 自动生成;Logstash 和 n9e ES 数据源都用它做 basic auth
ELASTIC_PASSWORD=
# Logstash NetFlow UDP 入口端口,对应 agent 的 NPROBE_COLLECTOR=<部署机IP>:5044
NETFLOW_PORT=5044

# 自然语言查询：兼容且有权限的数据源自动支持，后端逐次核验权限。
# 自动跟随已启用的默认 LLM；设 false 可手动关闭。
O9E_NATURAL_QUERY_ENABLED=true
O9E_NATURAL_QUERY_TTL_SECONDS=900
O9E_NATURAL_QUERY_TIMEOUT_SECONDS=90
O9E_NATURAL_QUERY_MAX_ACTIVE=128
# 运维周报后端复用 n9e + MySQL，不需要新的 agent 或报告容器。
O9E_REPORTS_ENABLED=false
O9E_REPORTS_RETENTION_DAYS=90
# 运维助手语音对讲；默认关闭。Google key 只配置在公网网关 .env。
O9E_VOICE_ENABLED=false
O9E_VOICE_GATEWAY_URL=
O9E_VOICE_CLIENT_ID=o9e
O9E_VOICE_GATEWAY_TOKEN=
O9E_VOICE_DATASOURCE_ID=0
O9E_VOICE_MAX_SECONDS=1200
# 趋势分析预测引擎(可选,docker-compose.forecast.yaml);默认关闭。TOKEN 为 n9e 与引擎间的内部认证,部署时用 openssl rand -hex 24 生成。
FORECAST_ENABLED=false
FORECAST_TAG=
FORECAST_ENGINE_TOKEN=
