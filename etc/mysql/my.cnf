[mysqld]
character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci
sql-mode             = "STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION"
max_connections      = 1000
# 2026-09-17 生产故障加固。
#
# 当天 6456 因 CPU 过载(2 核跑 13 个容器,load 45,运行队列 68)导致 mysqld 来不及
# 完成 TCP 握手,客户端超时断开被计为 aborted connect —— 29 小时累计 179492 次。
# MySQL 默认 max_connect_errors=100,同一来源攒够 100 次就把整个 IP 拉黑,于是
# 容器网关 172.20.0.1 被封,n9e 所有查库接口返回:
#   Error 1129: Host '172.20.0.1' is blocked because of many connection errors
#
# 该机制是为公网防暴力破解设计的,在只有容器网关一个来源的内网里没有防护价值,
# 却会把一次性能抖动放大成整站不可用。调到 10 万等于实质关闭,同时保留计数可观测。
#
# 治本仍是扩容 CPU —— 这一条只保证过载时不再叠加一次数据库自锁。
max_connect_errors   = 100000
default-time-zone    = "+08:00"
# 2026-10 安全加固(客户审计)。
# 登录失败连续 5 次后逐次加延迟,抑制口令暴力破解。只计「认证失败」,不计上面那种握手超时的
# aborted connect,与 max_connect_errors 的取舍不冲突。loose- 前缀:插件缺失时不致 mysqld 起不来。
plugin-load-add      = connection_control.so
loose-connection_control_failed_connections_threshold = 5
loose-connection_control_min_connection_delay         = 2000
local_infile         = 0

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
