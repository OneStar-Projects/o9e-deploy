# DeepFlow server 独立栈 —— 复制成 .env 后按注释改
# cp .env.example .env

# DeepFlow 版本。必须与「agent 包 / deepflow-ctl」三者同版本，否则 grpc 协议不兼容。
DEEPFLOW_VERSION=v7.1

# 本采集机(跑 deepflow-server + deepflow-agent 的这台)的节点 IP。
# deepflow-server 用它作对 agent 通告的默认 IP；agent 的 controller-ips 也指这里。
# ⚠ 改成本机实际 IP。
NODE_IP_FOR_DEEPFLOW=10.0.0.1
