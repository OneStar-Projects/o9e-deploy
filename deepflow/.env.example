# DeepFlow server 独立栈 —— 复制成 .env 后按注释改
# cp .env.example .env

# DeepFlow 版本。必须与「agent 包 / deepflow-ctl」三者同版本，否则 grpc 协议不兼容。
DEEPFLOW_VERSION=v7.1

# 本采集机(跑 deepflow-server + deepflow-agent 的这台)的节点 IP。
# deepflow-server 用它作对 agent 通告的默认 IP；agent 的 controller-ips 也指这里。
# ⚠ 必须是本机网卡上真实存在的 IP —— 不能填 VIP / 浮动 IP / 域名。
#    server 内部的 genesis/controller/ingester 用它自寻址，若填了本机连不通的 VIP，
#    genesis 死锁(日志 "get pod ip failed")、agent_sync 拿不到 VM、agent 永远注册不进。
#    多网卡时填 agent 能直连的那块网卡 IP；有 VIP 也要填真实网卡 IP，不是 VIP。
NODE_IP_FOR_DEEPFLOW=10.0.0.1

# deepflow-server 把聚合出的 flow_metrics 通过 prometheus remote-write 推给 n9e 的入口。
# 由 render-config.sh 渲染进 server.yaml(server 端 exporter 配置,agent-group-config 覆盖不到)。
# server 与 n9e 同机时填宿主机真实 IP,勿用 127.0.0.1(那是容器自身)。
N9E_REMOTE_WRITE=http://10.0.0.1:17000/prometheus/v1/write
