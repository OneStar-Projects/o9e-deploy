# 运行时机密 / 生成物,绝不入库
.env

# TLS 证书(自备真证书或 nginx auto-cert 现签),只保留 .gitkeep 和 README
etc/tls/*.pem
etc/tls/*.key

# 误拷的预编译二进制(本仓库纯 pull,不该有)
/n9e

# 备份文件
*.sql.bak
backup-*.sql
/1/

# 离线现场预放的 deepflow-ctl 二进制(~71MB),按需拷入,勿提交
deepflow/deepflow-ctl

# server.yaml 是 render-config.sh 从 .env 渲染的生成物(入库的是 .tmpl);
# 忽略成品,避免装机手改被 checkout/pull 打回默认值。
deepflow/common/config/deepflow-server/server.yaml
