# 此文件部署在公网网关机器；真实 .env 不提交仓库。
VOICE_TAG=
VOICE_HTTPS_PORT=443
GOOGLE_API_KEY=
# google / openai；供应商与模型仅在网关配置，不向普通用户展示。
VOICE_PROVIDER=google
# 建议显式填写经账号验收的模型 ID；OpenAI 可先验证 gpt-realtime。
VOICE_MODEL=
# OpenAI 默认 marin；Google 为空时使用其默认音色。
VOICE_VOICE=
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Google 完整发言转写模型；需支持音频输入和结构化 JSON。
VOICE_TRANSCRIPTION_MODEL=gemini-3.5-flash-lite
# Google / OpenAI 可选 HTTP CONNECT 代理；默认直接连接官方上游。
VOICE_UPSTREAM_PROXY=
O9E_VOICE_CLIENT_ID=o9e
# 至少 32 字符且不含空白，与内网 n9e 配置的服务凭据一致。
O9E_VOICE_GATEWAY_TOKEN=
# 以下均为十进制正整数；启动时拒绝非法或越界值。
VOICE_MAX_SESSIONS=5
# 1–3600 秒；与内网 O9E_VOICE_MAX_SECONDS 协调，先到的限制生效。
VOICE_MAX_SECONDS=1200
VOICE_MAX_USAGE_TOKENS=200000
# 1–2147483 秒；建议不超过会话上限。
VOICE_IDLE_SECONDS=120

# 护栏默认强制启用，共用当前供应商 API key；另需开通下列文本模型权限。
# 留空：OpenAI gpt-4.1-mini / Google gemini-3.5-flash-lite；可按账号可用模型修改。
VOICE_GUARDRAIL_MODEL=
# 文本检查超时 1–30000 毫秒；失败时停止对讲。
VOICE_GUARDRAIL_TIMEOUT_MS=8000
# 每次会话最多 1–1000 次分类，达到上限停止；不是跨会话用户配额。
VOICE_GUARDRAIL_MAX_CHECKS=200
